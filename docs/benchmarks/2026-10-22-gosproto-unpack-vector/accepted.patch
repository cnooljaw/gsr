diff --git a/unpack_vector_arm64.s b/unpack_vector_arm64.s
new file mode 100644
index 0000000..be7dd44
--- /dev/null
+++ b/unpack_vector_arm64.s
@@ -0,0 +1,86 @@
+//go:build arm64 && !purego
+#include "textflag.h"
+// 完整预检之后仅恢复字节，不分配、不保留指针。
+TEXT ·unpackVectorARM64(SB), NOSPLIT, $0-56
+	MOVD dst_base+0(FP), R0
+	MOVD src_base+24(FP), R1
+	MOVD src_len+32(FP), R2
+	ADD R1, R2, R2
+	MOVD table+48(FP), R3
+loop:
+	CMP R2, R1
+	BEQ done
+	MOVBU (R1), R4
+	ADD $1, R1
+	CBZ R4, zero
+	CMP $255, R4
+	BEQ ff
+	ADD R4<<4, R3, R5
+	MOVD 8(R5), R6
+	SUB R1, R2, R8
+	CMP $8, R8
+	BLO tail
+	FMOVD (R1), F0
+	FMOVD (R5), F1
+	VTBL V1.B8, [V0.B16], V2.B8
+	FMOVD F2, (R0)
+	ADD R6, R1
+	ADD $8, R0
+	B loop
+zero:
+	ADD $8, R0
+zero_more:
+	SUB R1, R2, R8
+	CMP $8, R8
+	BLO loop
+	MOVD (R1), R13
+	CBNZ R13, loop
+	ADD $8, R1
+	ADD $64, R0
+	B zero_more
+ff:
+	MOVBU (R1), R6
+	ADD $1, R1
+	ADD $1, R6
+	LSL $3, R6
+	CMP $64, R6
+	BLO ff_copy
+ff_bulk:
+	LDP (R1), (R7, R8)
+	STP (R7, R8), (R0)
+	LDP 16(R1), (R7, R8)
+	STP (R7, R8), 16(R0)
+	LDP 32(R1), (R7, R8)
+	STP (R7, R8), 32(R0)
+	LDP 48(R1), (R7, R8)
+	STP (R7, R8), 48(R0)
+	ADD $64, R1
+	ADD $64, R0
+	SUB $64, R6
+	CMP $64, R6
+	BHS ff_bulk
+	CBZ R6, loop
+ff_copy:
+	MOVD (R1), R7
+	MOVD R7, (R0)
+	ADD $8, R1
+	ADD $8, R0
+	SUB $8, R6
+	CBNZ R6, ff_copy
+	B loop
+tail:
+	MOVD R4, R9
+	MOVD R0, R12
+tail_byte:
+	TBZ $0, R9, tail_skip
+	MOVBU (R1), R11
+	ADD $1, R1
+	MOVB R11, (R12)
+tail_skip:
+	ADD $1, R12
+	LSR $1, R9
+	CBNZ R9, tail_byte
+	ADD $8, R0
+	B loop
+done:
+	RET
diff --git a/unpack_guard_arm64_test.go b/unpack_guard_arm64_test.go
new file mode 100644
index 0000000..599f29d
--- /dev/null
+++ b/unpack_guard_arm64_test.go
@@ -0,0 +1,99 @@
+//go:build arm64 && !purego && (darwin || linux)
+
+package sproto
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"syscall"
+	"testing"
+)
+
+func guardedVectorBuffer(t *testing.T, size int) ([]byte, []byte) {
+	t.Helper()
+	page := os.Getpagesize()
+	if size > page {
+		t.Fatal("guarded fixture too large")
+	}
+	mapping, err := syscall.Mmap(-1, 0, 3*page, syscall.PROT_READ|syscall.PROT_WRITE, syscall.MAP_ANON|syscall.MAP_PRIVATE)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := syscall.Munmap(mapping); err != nil {
+			t.Error(err)
+		}
+	})
+	if err := syscall.Mprotect(mapping[:page], syscall.PROT_NONE); err != nil {
+		t.Fatal(err)
+	}
+	if err := syscall.Mprotect(mapping[2*page:], syscall.PROT_NONE); err != nil {
+		t.Fatal(err)
+	}
+	middle := mapping[page : 2*page : 2*page]
+	for i := range middle[:page-size] {
+		middle[i] = 0xa5
+	}
+	return middle[page-size : page : page], middle
+}
+
+// 保护页验证所有mask的源尾/目标尾不会被向量窗口越过，并覆盖短尾回退及连续零/FF段。
+func TestUnpackVectorGuardPages(t *testing.T) {
+	for mask := 0; mask < 256; mask++ {
+		for _, count := range []int{1, 127, 128, 129} {
+			t.Run(fmt.Sprintf("%d/%d", mask, count), func(t *testing.T) {
+				var word [8]byte
+				packedWord := []byte{byte(mask)}
+				if mask == 255 {
+					packedWord = append(packedWord, 0)
+				}
+				for i := range word {
+					if mask&(1<<i) != 0 {
+						word[i] = byte(0x81 + i)
+						packedWord = append(packedWord, word[i])
+					}
+				}
+				packed := bytes.Repeat(packedWord, count)
+				want := bytes.Repeat(word[:], count)
+				input, inputPage := guardedVectorBuffer(t, len(packed))
+				copy(input, packed)
+				if err := syscall.Mprotect(inputPage, syscall.PROT_READ); err != nil {
+					t.Fatal(err)
+				}
+				got, err := UnpackWithLimit(input, len(want))
+				if err != nil || !bytes.Equal(got, want) {
+					t.Fatalf("public result: %v", err)
+				}
+				output, outputPage := guardedVectorBuffer(t, len(want))
+				if !unpackVector(output, input) || !bytes.Equal(output, want) {
+					t.Fatal("vector result")
+				}
+				for _, b := range outputPage[:len(outputPage)-len(output)] {
+					if b != 0xa5 {
+						t.Fatal("write before output")
+					}
+				}
+			})
+		}
+	}
+}
+
+// FF连续段在64字节批量复制边界及最大256word长度上不得越过只读源页或目标页。
+func TestUnpackVectorFFGuardPages(t *testing.T) {
+	for _, count := range []int{0, 1, 6, 7, 8, 15, 16, 30, 31, 32, 254, 255} {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
+			want := bytes.Repeat([]byte{0xf1}, (count+1)*8)
+			packed := append([]byte{255, byte(count)}, want...)
+			input, page := guardedVectorBuffer(t, len(packed))
+			copy(input, packed)
+			if err := syscall.Mprotect(page, syscall.PROT_READ); err != nil {
+				t.Fatal(err)
+			}
+			output, _ := guardedVectorBuffer(t, len(want))
+			if !unpackVector(output, input) || !bytes.Equal(output, want) {
+				t.Fatal("FF result")
+			}
+		})
+	}
+}
