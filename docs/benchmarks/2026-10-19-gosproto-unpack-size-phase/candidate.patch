 // UnpackWithLimit 在扩容前限制解包后含填充的长度；packed 输入大小由调用方限制。
 func UnpackWithLimit(src []byte, maxBytes int) ([]byte, error) {
+	size, err := unpackedSize(src, maxBytes)
+	if err != nil {
+		return nil, err
+	}
+	unpacked := make([]byte, size)
+	offset := 0
+	for len(src) > 0 {
+		header := src[0]
+		if header == 0 {
+			run := 1
+			if len(src) >= 2 && src[1] == 0 {
+				run = 2 + zeroHeaderPrefix(src[2:])
+			}
+			// 输出由本次 make 清零，已预检的零段只需推进游标。
+			offset += run * 8
+			src = src[run:]
+			continue
+		}
+		src = src[1:]
+		if header == 0xff {
+			length := (int(src[0]) + 1) * 8
+			copy(unpacked[offset:], src[1:1+length])
+			offset += length
+			src = src[1+length:]
+			continue
+		}
+		// 零 mask 已在上方消费，普通 mask 至少有一个有效字节。
+		used := 0
+		for mask := header; ; {
+			index := bits.TrailingZeros8(mask)
+			unpacked[offset+index] = src[used]
+			used++
+			mask &= mask - 1
+			if mask == 0 {
+				break
+			}
+		}
+		src = src[used:]
+		offset += 8
+	}
+	return unpacked, nil
+}
