+// packZeroWords 在调用点已确认两个完整零 word 后，仅统计后续完整 word 并清零 mask 区。
+// 保持批量分支独立，避免扫描和清零的临时状态进入普通 word 热路径。
+//
+//go:noinline
+func packZeroWords(dst, afterTwo []byte) int {
+	words := 2 + zeroBytePrefix(afterTwo)/8
+	clear(dst[:words])
+	return words
+}
