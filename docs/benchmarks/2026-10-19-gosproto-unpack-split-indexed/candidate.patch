+// unpackedSize 在任何输出分配前校验完整输入和解包预算，返回含填充的确切长度。
+func unpackedSize(src []byte, maxBytes int) (int, error) {
+	if maxBytes < 1 {
+		return 0, ErrInvalidLimits
+	}
+	// 首次只扫描 tag/连续块长度，在分配前确认完整边界及有限的确切输出长度。
+	size := 0
+	for position := 0; position < len(src); {
+		available := len(src) - position
+		header := src[position]
+		consumed, produced := 1, 8
+		if header == 0 {
+			if available >= 2 && src[position+1] == 0 {
+				words := (maxBytes - size) / 8
+				if words < 2 {
+					return 0, ErrLimit
+				}
+				// 多检查一个零 mask 即可判定超额，不为小预算扫描整段大输入。
+				end := min(available, words+1)
+				run := 2 + zeroHeaderPrefix(src[position+2:position+end])
+				if run > words {
+					return 0, ErrLimit
+				}
+				consumed, produced = run, run*8
+			}
+		} else if header == 0xff {
+			if available < 2 {
+				return 0, ErrUnpack
+			}
+			produced = (int(src[position+1]) + 1) * 8
+			consumed = 2 + produced
+		} else {
+			consumed += bits.OnesCount8(header)
+		}
+		if consumed > available {
+			return 0, ErrUnpack
+		}
+		if produced > maxBytes-size {
+			return 0, ErrLimit
+		}
+		size += produced
+		position += consumed
+	}
+	return size, nil
+}
