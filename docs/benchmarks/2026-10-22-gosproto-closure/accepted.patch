diff --git a/pack_words_arm64.s b/pack_words_arm64.s
new file mode 100644
index 0000000..4b0e9fe
--- /dev/null
+++ b/pack_words_arm64.s
@@ -0,0 +1,46 @@
+//go:build arm64 && !purego
+
+#include "textflag.h"
+
+// 只处理完整普通word，FF及短尾交回Go；调用方保证输出增长额度和八字节余量。
+TEXT ·packWordsARM64(SB), NOSPLIT, $0-72
+	MOVD dst_base+0(FP), R4
+	MOVD src_base+24(FP), R1
+	MOVD src_len+32(FP), R2
+	MOVD table+48(FP), R3
+	MOVD $0x7f7f7f7f7f7f7f7f, R12
+	MOVD $0x8080808080808080, R13
+	MOVD $0x0102040810204080, R14
+pack_words_loop:
+	CMP $8, R2
+	BLO pack_words_done
+	MOVD (R1), R6
+	AND R12, R6, R7
+	ADD R12, R7
+	ORR R6, R7
+	AND R13, R7
+	LSR $7, R7
+	MUL R14, R7
+	LSR $56, R7, R8
+	CMP $255, R8
+	BEQ pack_words_done
+	ADD R8<<4, R3, R9
+	MOVD 8(R9), R10
+	FMOVD R6, F0
+	FMOVD (R9), F1
+	VTBL V1.B8, [V0.B16], V2.B8
+	FMOVD F2, 1(R4)
+	MOVB R8, (R4)
+	ADD $1, R10
+	ADD R10, R4
+	ADD $8, R1
+	SUB $8, R2
+	B pack_words_loop
+pack_words_done:
+	MOVD dst_base+0(FP), R0
+	SUB R0, R4
+	MOVD R4, written+56(FP)
+	MOVD src_len+32(FP), R0
+	SUB R2, R0
+	MOVD R0, consumed+64(FP)
+	RET
diff --git a/pack_words_arm64_test.go b/pack_words_arm64_test.go
new file mode 100644
index 0000000..1f1681a
--- /dev/null
+++ b/pack_words_arm64_test.go
@@ -0,0 +1,105 @@
+//go:build arm64 && !purego
+
+package sproto
+
+import (
+	"bytes"
+	"testing"
+)
+
+// TestPackWordsDifferential 保护普通mask压紧、FF停止、尾部和共享工作区的wire与容量。
+func TestPackWordsDifferential(t *testing.T) {
+	check := func(input []byte) {
+		t.Helper()
+		before := bytes.Clone(input)
+		capacity := packedBufferSize(len(input))
+		want := referencePackInto(make([]byte, capacity), input)
+		got := Pack(input)
+		if !bytes.Equal(got, want) || cap(got) != cap(want) || !bytes.Equal(input, before) {
+			t.Fatal("public Pack mismatch", len(input))
+		}
+		workspace := make([]byte, capacity)
+		start := capacity - len(input)
+		copy(workspace[start:], input)
+		shared := packInto(workspace, workspace[start:])
+		if !bytes.Equal(shared, want) || cap(shared) != cap(want) {
+			t.Fatal("shared workspace mismatch", len(input))
+		}
+		if len(input) >= 8 && len(input) <= 1<<20 {
+			consumed := 0
+			for consumed+8 <= len(input) {
+				ff := true
+				for _, v := range input[consumed : consumed+8] {
+					if v == 0 {
+						ff = false
+					}
+				}
+				if ff {
+					break
+				}
+				consumed += 8
+			}
+			output := make([]byte, capacity)
+			written, used := packWordsFast(output, input)
+			expected := referencePackInto(make([]byte, packedBufferSize(consumed)), input[:consumed])
+			if used != consumed || written != len(expected) || !bytes.Equal(output[:written], expected) {
+				t.Fatal("native prefix mismatch", len(input), written, used, consumed)
+			}
+		}
+	}
+	for mask := 0; mask < 256; mask++ {
+		var word [8]byte
+		for bit := range word {
+			if mask&(1<<bit) != 0 {
+				word[bit] = byte(0x81 + bit)
+			}
+		}
+		for _, words := range []int{1, 16, 255, 256, 257} {
+			for tail := 0; tail < 8; tail++ {
+				input := append(bytes.Repeat(word[:], words), bytes.Repeat([]byte{0x8f}, tail)...)
+				check(input)
+			}
+		}
+	}
+	for _, length := range []int{127, 128, 129, (1 << 20) - 1, 1 << 20, (1 << 20) + 1} {
+		input := make([]byte, length)
+		for i := range input {
+			if i%8 != 0 {
+				input[i] = 0x81
+			}
+		}
+		check(input)
+	}
+	// 交替FF与至少16个普通word，覆盖消耗增长额度后继续原生写出的重叠窗口。
+	for _, ffWords := range []int{1, 255, 256, 257} {
+		for _, mask := range []byte{0, 1, 31, 127} {
+			var word [8]byte
+			for bit := range word {
+				if mask&(1<<bit) != 0 {
+					word[bit] = byte(0x81 + bit)
+				}
+			}
+			for tail := 0; tail < 8; tail++ {
+				input := bytes.Repeat([]byte{0x81}, ffWords*8)
+				input = append(input, bytes.Repeat(word[:], 16)...)
+				input = append(input, bytes.Repeat([]byte{0x82}, 8)...)
+				input = append(input, bytes.Repeat(word[:], 17)...)
+				input = append(input, bytes.Repeat([]byte{0x83}, tail)...)
+				check(input)
+			}
+		}
+	}
+	state := uint32(0x13579bdf)
+	for i := 0; i < 4096; i++ {
+		state = state*1664525 + 1013904223
+		input := make([]byte, int(state%4097))
+		for j := range input {
+			state = state*1664525 + 1013904223
+			input[j] = byte(state >> 24)
+			if j%3 == 0 {
+				input[j] = 0
+			}
+		}
+		check(input)
+	}
+}
diff --git a/pack_words_guard_arm64_test.go b/pack_words_guard_arm64_test.go
new file mode 100644
index 0000000..ed0efd4
--- /dev/null
+++ b/pack_words_guard_arm64_test.go
@@ -0,0 +1,49 @@
+//go:build arm64 && !purego && (darwin || linux)
+
+package sproto
+
+import (
+	"bytes"
+	"fmt"
+	"syscall"
+	"testing"
+)
+
+// TestPackWordsGuardPages 保护原生压紧只读源及精确预留输出的边界，覆盖所有mask和短尾。
+func TestPackWordsGuardPages(t *testing.T) {
+	for mask := 0; mask < 256; mask++ {
+		var word [8]byte
+		for bit := range word {
+			if mask&(1<<bit) != 0 {
+				word[bit] = byte(0x81 + bit)
+			}
+		}
+		for _, count := range []int{1, 16, 256} {
+			for _, tail := range []int{0, 1, 7} {
+				t.Run(fmt.Sprintf("%d/%d/%d", mask, count, tail), func(t *testing.T) {
+					raw := append(bytes.Repeat(word[:], count), bytes.Repeat([]byte{0x9f}, tail)...)
+					input, inputPage := guardedVectorBuffer(t, len(raw))
+					copy(input, raw)
+					if err := syscall.Mprotect(inputPage, syscall.PROT_READ); err != nil {
+						t.Fatal(err)
+					}
+					output, outputPage := guardedVectorBuffer(t, packedBufferSize(len(input)))
+					used := count * 8
+					if mask == 255 {
+						used = 0
+					}
+					want := referencePackInto(make([]byte, packedBufferSize(used)), input[:used])
+					written, consumed := packWordsFast(output, input)
+					if consumed != used || written != len(want) || !bytes.Equal(output[:written], want) || !bytes.Equal(input, raw) {
+						t.Fatal("native output mismatch")
+					}
+					for _, value := range outputPage[:len(outputPage)-len(output)] {
+						if value != 0xa5 {
+							t.Fatal("output prefix changed")
+						}
+					}
+				})
+			}
+		}
+	}
+}
diff --git a/pack_native_reference_arm64_test.go b/pack_native_reference_arm64_test.go
new file mode 100644
index 0000000..2b56774
--- /dev/null
+++ b/pack_native_reference_arm64_test.go
@@ -0,0 +1,69 @@
+//go:build arm64 && !purego
+
+package sproto
+
+import (
+	"encoding/binary"
+	"math/bits"
+)
+
+func referencePackInto(packed, src []byte) []byte {
+	offset := 0
+	for len(src) >= 8 {
+		word := binary.LittleEndian.Uint64(src)
+		nonzero := (((word & 0x7f7f7f7f7f7f7f7f) + 0x7f7f7f7f7f7f7f7f) | word) & 0x8080808080808080
+		header := uint8(((nonzero >> 7) * 0x0102040810204080) >> 56)
+		if header == 0xff {
+			consumed := ffRunBytes(src)
+			writeFF(packed[offset:], src, consumed)
+			offset += 2 + ((consumed + 7) &^ 7)
+			src = src[consumed:]
+			continue
+		}
+		// 去掉至多两个置位后是否为零，比普通路径完整计数更直接。
+		remaining := header & (header - 1)
+		if remaining&(remaining-1) == 0 {
+			// 长度与容量均固定且非空，避免每个 word 重算动态切片的指针掩码。
+			dst := packed[offset : offset+3 : offset+3]
+			// 已确认至多两个非零字节，直接写固定位置，避免通用循环和可变目标索引。
+			_ = dst[2]
+			dst[0] = header
+			index := 1
+			if header != 0 {
+				shift := bits.TrailingZeros8(header) * 8
+				dst[1] = byte(word >> shift)
+				index = 2
+				if remaining != 0 {
+					shift = bits.TrailingZeros8(remaining) * 8
+					dst[2] = byte(word >> shift)
+					index = 3
+				}
+			}
+			offset += index
+		} else {
+			dst := packed[offset : offset+9 : offset+9]
+			// Pack 预留八字节尾空间，零字节暂写的位置会被下一个有效字节覆盖，不进入返回切片。
+			_ = dst[8]
+			// 固定八字节视图越过 mask，非零字节位置直接使用 0～7 的前缀计数。
+			payload := dst[1:9]
+			// 0/1 字节标志相乘得到前缀和，每个和至多为 8，不跨字节进位。
+			// FF 已在前面处理；各目标位置只依赖对应前缀，不串行累加 index。
+			ranks := (nonzero >> 7) * 0x0101010101010101
+			payload[0] = byte(word)
+			payload[int(ranks&7)] = byte(word >> 8)
+			payload[int((ranks>>8)&7)] = byte(word >> 16)
+			payload[int((ranks>>16)&7)] = byte(word >> 24)
+			payload[int((ranks>>24)&7)] = byte(word >> 32)
+			payload[int((ranks>>32)&7)] = byte(word >> 40)
+			payload[int((ranks>>40)&7)] = byte(word >> 48)
+			payload[int((ranks>>48)&7)] = byte(word >> 56)
+			dst[0] = header
+			offset += 1 + int(ranks>>56)
+		}
+		src = src[8:]
+	}
+	if len(src) > 0 {
+		offset += packSegment(packed[offset:], src, 0)
+	}
+	return packed[:offset]
+}
