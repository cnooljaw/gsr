diff --git a/CHANGES.md b/CHANGES.md
index 09e93bc..ea3c39c 100644
--- a/CHANGES.md
+++ b/CHANGES.md
@@ -2,0 +3,3 @@
+- ARM64非purego将连续普通word用原生位图与VTBL批量压紧，FF合并与短尾仍走Go；只在限定长度且至少两个连续普通word时进入原生循环。固定4KiB只读置换表，保留原输出容量、共享工作区间隔、源不变及官方wire。M2整数EncodePacked两轮约改善35%，大型约14%～18%，小包及ASCII的局部差异见GSR收尾报告。
+- 编译期平台开关使purego及其他架构完全移除批量入口，包括无用的参数切片检查；新增全mask/FF停止/短尾/阈值大输入/交替FF共享工作区差分及只读源/输出保护页验证。
+
diff --git a/pack.go b/pack.go
index 866ee8a..6ccc484 100644
--- a/pack.go
+++ b/pack.go
@@ -121,0 +122,12 @@ func packInto(packed, src []byte) []byte {
+		if packWordsEnabled && len(src) >= 128 && len(src) <= 1<<20 {
+			// 至少两个连续普通word再承担批量入口成本；FF交给已有合并循环。
+			next := binary.LittleEndian.Uint64(src[8:])
+			if (next-0x0101010101010101)&^next&0x8080808080808080 != 0 {
+				written, consumed := packWordsFast(packed[offset:], src)
+				if consumed > 0 {
+					offset += written
+					src = src[consumed:]
+					continue
+				}
+			}
+		}
diff --git a/pack_words_arm64.go b/pack_words_arm64.go
new file mode 100644
index 0000000..749d56b
--- /dev/null
+++ b/pack_words_arm64.go
@@ -0,0 +1,34 @@
+//go:build arm64 && !purego
+
+package sproto
+
+// 编译期关闭不支持平台的整段入口，连参数切片检查也不保留。
+const packWordsEnabled = true
+
+// 固定16字节表项，保存按有效源字节排序的置换索引及字节数。
+type packWordEntry struct{ indexes, count uint64 }
+
+// 固定4KiB置换表在初始化后只读，未使用的索引用255产生零字节。
+var packWordTable = func() (table [256]packWordEntry) {
+	for header := range table {
+		indexes := ^uint64(0)
+		rank := 0
+		for position := 0; position < 8; position++ {
+			if header&(1<<position) != 0 {
+				indexes &^= uint64(255) << (rank * 8)
+				indexes |= uint64(position) << (rank * 8)
+				rank++
+			}
+		}
+		table[header] = packWordEntry{indexes, uint64(rank)}
+	}
+	return table
+}()
+
+// packWordsFast 同步压紧普通word，不保留源；范围与重叠间隔由packInto建立。
+func packWordsFast(dst, src []byte) (int, int) {
+	return packWordsARM64(dst, src, &packWordTable)
+}
+
+//go:noescape
+func packWordsARM64(dst, src []byte, table *[256]packWordEntry) (written int, consumed int)
