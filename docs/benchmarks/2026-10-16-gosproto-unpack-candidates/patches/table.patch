+// unpackMasks 只保存 wire mask 的固定事实，不含消息数据；高八位为有效字节数，
+// 低二十四位按每三位记录一个目标位置。初始化后只读，共 1 KiB。
+var unpackMasks = func() [256]uint32 {
+	var masks [256]uint32
+	for header := range masks {
+		var positions uint32
+		count := 0
+		for bit := 0; bit < 8; bit++ {
+			if header&(1<<bit) != 0 {
+				positions |= uint32(bit) << (count * 3)
+				count++
+			}
+		}
+		masks[header] = positions | uint32(count)<<24
+	}
+	return masks
+}()
