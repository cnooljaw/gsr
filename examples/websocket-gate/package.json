{
  "name": "gsr-websocket-gate-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "generate": "cd ../.. && buf generate && node examples/websocket-gate/scripts/normalize-generated.mjs",
    "build": "tsc --project tsconfig.json",
    "test:crypto": "npm run build && node --test client/dist/auth_vectors.test.js client/dist/secure_auth.test.js",
    "client": "npm run build && node client/dist/index.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@types/node": "22.20.3",
    "typescript": "5.9.3"
  }
}
