{
  "name": "gsr-websocket-gate-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "generate": "cd ../.. && buf generate && node examples/websocket-gate/scripts/normalize-generated.mjs",
    "build": "node scripts/sync-sproto.mjs --check && tsc --project tsconfig.json",
    "test:crypto": "npm run build && node --test client/dist/auth_vectors.test.js client/dist/secure_auth.test.js",
    "client": "npm run build && node client/dist/index.js",
    "generate:sproto": "node scripts/generate-sproto.mjs",
    "test:sproto": "npm run build && node --test client/dist/sproto_client.test.js",
    "client:sproto": "npm run build && node client/dist/sproto_client.js",
    "test:sproto:integration": "npm run build && go build -o ../../tmp/sproto-echo ./cmd/debugserver && GSR_SPROTO_SERVER_BIN=../../tmp/sproto-echo node --test client/dist/sproto_client.test.js",
    "sync:sproto": "node scripts/sync-sproto.mjs",
    "check:sproto-source": "node scripts/sync-sproto.mjs --check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@types/node": "22.20.3",
    "typescript": "5.9.3"
  }
}
